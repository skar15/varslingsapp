{
  "name": "@varsling/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/dev.ts",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed-cli.ts",
    "openapi:dump": "tsx scripts/dump-openapi.ts ../../packages/api-client/openapi.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@sentry/node": "^11.10.0",
    "@varsling/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.15",
    "pg": "^8.16.0",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "stripe": "^23.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "@testcontainers/postgresql": "^12.2.1"
  }
}
