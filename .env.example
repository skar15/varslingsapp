# Copy to .env (never commit .env). Values without defaults are required in production.
APP_ENV=development
PORT=4000
# Host port for `docker compose up -d db`. If 5432 is taken, use 5433 here AND in the two URLs below.
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/varsling
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/varsling_test

# Supabase (EU region). The service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy HS256 secret; when empty the API verifies tokens against the project's JWKS.
SUPABASE_JWT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price per plan key (plans live in config/plans.json; prices only in Stripe).
STRIPE_PRICE_ID_BASIS=
STRIPE_PRICE_ID_FAMILIE=
STRIPE_PRICE_ID_BEDRIFT=

EXPO_ACCESS_TOKEN=
# Set to true only when Apple has granted the critical alerts entitlement.
IOS_CRITICAL_ALERTS=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER_ID=

RESEND_API_KEY=
EMAIL_FROM=

# Required for every MET request: application name plus a contact address or URL,
# supplied by the project owner. MET is never called while this is empty.
MET_USER_AGENT=
MET_POLL_INTERVAL_SEC=600
NVE_POLL_INTERVAL_SEC=600
NVE_ENABLED=true

LIGHT_HORIZON_HOURS=72
STATUS_EXTENSION_GRACE_MINUTES=120
PAST_DUE_GRACE_DAYS=7
MAX_AREA_KM2=2500
NOTIFICATION_RETENTION_MONTHS=13

HEARTBEAT_URL=
SENTRY_DSN=
# Simulate-alert route; never registered when APP_ENV=production.
ADMIN_API_KEY=
# 32+ random characters; encrypts the claim token in Stripe checkout metadata.
CLAIM_TOKEN_SECRET=

WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EAS_PROJECT_ID=
