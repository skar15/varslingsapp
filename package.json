{
  "name": "varslingsapp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.15" },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@varsling/api --filter=@varsling/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:setup": "pnpm --filter @varsling/web exec playwright install chromium",
    "test:e2e:mobile": "pnpm --filter @varsling/mobile test:e2e:mobile",
    "db:migrate": "pnpm --filter @varsling/api db:migrate",
    "db:seed": "pnpm --filter @varsling/api db:seed",
    "api-client:generate": "pnpm --filter @varsling/api openapi:dump && pnpm --filter @varsling/api-client generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver", "@sentry/cli"]
  }
}
